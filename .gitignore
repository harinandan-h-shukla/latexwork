# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# In-browser WASM LaTeX compiler assets (texlyre-busytex) — ~500MB of
# wasm/data files fetched from GitHub Releases by `npm run download-compiler-assets`
# (lib/browser-compiler), not committed: far past what's reasonable to
# track in git or upload as deployment source (see Vercel's 100MB/1GB
# static-file-upload limits) or a public GitHub repo's own per-file caps.
# Provisioned as a deploy-time step instead — see that script's own
# comments for the current, real caveats around this.
/public/core/

# typescript
*.tsbuildinfo
next-env.d.ts

# docs/planning files — kept locally, not pushed
*.md
